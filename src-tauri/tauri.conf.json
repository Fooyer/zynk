{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zynk",
  "version": "0.1.0-mvp",
  "identifier": "com.zynk.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zynk",
        "width": 1360,
        "height": 860,
        "minWidth": 940,
        "minHeight": 600,
        "decorations": false,
        "backgroundColor": "#0a0a0b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
